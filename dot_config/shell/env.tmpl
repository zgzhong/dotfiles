# shellcheck shell=sh
# Managed by chezmoi. Source this file from your shell rc.

{{- $role := (.role | default "") }}

export DOTFILES_ROLE={{ $role | quote }}
export DOTFILES_OS={{ .chezmoi.os | quote }}

{{- if eq $role "office" }}
export DOTFILES_WORK_CONTEXT="1"
{{- else if eq $role "home" }}
export DOTFILES_HOME_CONTEXT="1"
{{- end }}
