#!/usr/bin/env bash
set -euo pipefail

{{ template "brew-lib.sh.tmpl" . }}

os="{{ .chezmoi.os }}"

if ! resolve_brew_shellenv "$os"; then
  echo "[chezmoi] brew not found; will retry default shell change on next apply." >&2
  exit 1
fi

brew_zsh="$(brew --prefix)/bin/zsh"

if [[ ! -x "$brew_zsh" ]]; then
  echo "[chezmoi] Homebrew zsh not found at $brew_zsh; will retry on next apply." >&2
  exit 1
fi

get_login_shell() {
  local user
  user="$(whoami)"
{{- if eq .chezmoi.os "darwin" }}
  dscl . -read "/Users/$user" UserShell 2>/dev/null | awk '{print $2}'
{{- else }}
  getent passwd "$user" 2>/dev/null | cut -d: -f7
{{- end }}
}

current_shell="$(get_login_shell)"
if [[ -z "$current_shell" ]]; then
  echo "[chezmoi] Could not determine login shell for $(whoami)." >&2
  exit 1
fi

if [[ "$current_shell" == "$brew_zsh" ]]; then
  echo "[chezmoi] Default shell is already $brew_zsh"
  exit 0
fi

# Ensure brew zsh is listed in /etc/shells
if ! grep -qxF "$brew_zsh" /etc/shells 2>/dev/null; then
  echo "[chezmoi] Adding $brew_zsh to /etc/shells..."
  echo "$brew_zsh" | sudo tee -a /etc/shells >/dev/null
fi

echo "[chezmoi] Changing default shell to $brew_zsh..."
sudo chsh -s "$brew_zsh" "$(whoami)"
echo "[chezmoi] Default shell changed. Open a new session to use it."
